#!/usr/bin/env python3
"""Package OXO-delivered Ortho4XP tiles into an installed XEarthLayer package.

Usage: oxo-package <spec.toml> --code <CODE> [--dry-run] [--strict|--loose]
                   [--packages-dir DIR]

Every zOrtho4XP_<tile>/ under the spec's [target] root counts as done (egress
is atomic). All tiles are validated first; any rejection aborts before
anything is copied. Then DSF, .ter and .png masks are copied into a fresh
staging directory next to <packages-dir>/zzXEL_<metadata.name>_ortho/,
xearthlayer_scenery_package.txt is written, and the staging directory replaces
the package — so a rebuild leaves no stale files behind. Ported from
sync-xel-package.

  --strict  (default) DSF > 10000 B, .ter references
            _BI<zl>.dds, at least one .png mask, no partial files, no newer
            .dsf.bak
  --loose   .png masks optional (desert tiles); everything else still required

Night lighting (issue #17): XEL reads a tile's night recipe night/<block>/<tile>.oxn
from the first installed package that has it (priority: lowercased package code)
and colours its LEDs by that package's code, so recipes are never copied here.
Per tile, that source package (never the one being built) supplies the LIT lines
(TEXTURE_LIT, LUMINANCE) of its land .ter with the same <y>_<x> grid and ZL; ours
get the same lines, TEXTURE_LIT renamed to our base texture + _LIT. A land .ter
without counterpart (e.g. ZL18 airport textures) takes the tile's LIT set if its
counterparts agree on one; otherwise it stays dark with a warning. *_overlay
(water) .ter stay dark. Only the staged copies change. A tile without recipe
stays dark with a warning. --dry-run prints the per-tile plan; an install appends
one row per tile to ledger/<name>/night.tsv (when, code, tile, source package,
its code line, lit .ter, LUMINANCE values, note).

Before the staged package replaces the installed one it is checked: every DSF,
.ter and .png mask of the delivered tiles is there, every .ter carries exactly
the planned LIT lines (pointing at its own texture) and is otherwise unchanged,
no overlay .ter is lit. Any problem aborts and leaves the installed package as is.
"""
import argparse
import datetime
import fnmatch
import math
import os
import re
import shutil
import sys
import tomllib
from pathlib import Path

TILE_RE = re.compile(r"^[+-]\d{2}[+-]\d{3}$")
CODE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
PARTIAL_PATTERNS = ("*.tmp", "*.part", "*.partial")
# <y>_<x>_<provider><zl>[_<kind>_overlay].ter, provider as XEL's DDS pattern has it
TER_RE = re.compile(r"^(\d+)_(\d+)_([A-Za-z]+\d?)(\d{2})(_[a-z]+_overlay)?\.ter$")
BASE_RE = re.compile(r"^BASE_TEX\S*\s+(\S+)\.dds\s*$", re.M)
LIT_KEYS = ("TEXTURE_LIT", "LUMINANCE")


class Fatal(Exception):
    pass


def log(msg):
    print(f"[{datetime.datetime.now():%F %T}] {msg}", flush=True)


def default_lock_file():
    state = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(state) / "xearthlayer" / "xearthlayer.lock"


def check_lock(lock_file):
    """Return the PID of a live `xearthlayer run`, or None. Warns on a stale lock."""
    try:
        text = Path(lock_file).read_text().strip()
    except FileNotFoundError:
        return None
    if not text:
        return None
    try:
        pid = int(text.split()[0])
    except ValueError:
        print(f"WARNING: unreadable lock file {lock_file}: {text[:40]!r}", file=sys.stderr)
        return None
    try:
        os.kill(pid, 0)
    except PermissionError:
        return pid
    except (ProcessLookupError, OverflowError):
        print(f"WARNING: stale lock {lock_file} (PID {pid} not running), left in place",
              file=sys.stderr)
        return None
    return pid


def block_of(tile):
    """10-degree block directory of a tile, as Ortho4XP names it (floor)."""
    lat, lon = int(tile[:3]), int(tile[3:])
    return f"{math.floor(lat / 10) * 10:+03d}{math.floor(lon / 10) * 10:+04d}"


def has_partials(d):
    base_depth = len(d.parts)
    for dirpath, dirnames, filenames in os.walk(d):
        depth = len(Path(dirpath).parts) - base_depth
        for name in dirnames + filenames:
            if any(fnmatch.fnmatch(name, p) for p in PARTIAL_PATTERNS):
                return True
        if depth >= 2:
            dirnames[:] = []
    return False


def validate_tile(d, tile, mode):
    """Return (dsf_path, None) if valid, else (None, reason)."""
    if not TILE_RE.match(tile):
        return None, "bad tile name"

    nav = d / "Earth nav data"
    candidates = [nav / f"{tile}.dsf"] + sorted(nav.glob(f"*/{tile}.dsf"))
    dsf = next((p for p in candidates if p.is_file()), None)
    if dsf is None:
        return None, "no DSF"
    size = dsf.stat().st_size
    if size <= 10000:
        return None, f"DSF too small: {size}B"

    ters = sorted((d / "terrain").glob("*.ter"))
    if not ters:
        return None, "no .ter files"
    if not re.search(r"_BI[0-9]+\.dds", ters[0].read_text(errors="replace")):
        return None, "no BI provider in .ter"

    if mode == "strict" and not any((d / "textures").glob("*.png")):
        return None, "no .png masks"

    if has_partials(d):
        return None, "partial files present"

    bak = Path(f"{dsf}.bak")
    if bak.is_file() and bak.stat().st_mtime > dsf.stat().st_mtime:
        return None, "stale DSF (.bak newer)"

    return dsf, None


def night_sources(packages_dir, exclude):
    """Installed packages other than `exclude`, in XEL's priority order:
    [(dir, code line)]. A package without metadata is not a source."""
    found = []
    for d in packages_dir.glob("zzXEL_*_ortho"):
        if d.name == exclude or not d.is_dir():
            continue
        try:
            line = (d / "xearthlayer_scenery_package.txt").read_text().splitlines()[2].strip()
        except (OSError, IndexError):
            continue
        if line:
            found.append((line.split()[0].lower(), d.name, d, line))
    return [(d, line) for _, _, d, line in sorted(found)]


def lit_lines(text):
    return [" ".join(l.split()) for l in text.splitlines() if l.split()[:1]
            and l.split()[0] in LIT_KEYS]


def night_plan(tile, tile_dir, sources, providers):
    """What night lighting a tile gets: {source, code, lit: {ter name: lines}, notes}.
    `providers` caches per source dir the provider prefixes of its land .ter (e.g.
    GO2), so a counterpart is looked up by name instead of indexing every file."""
    land = [t for t in sorted((tile_dir / "terrain").glob("*.ter"))
            if (m := TER_RE.match(t.name)) and not m[5]]
    plan = {"source": "", "code": "", "land": len(land), "lit": {}, "notes": []}
    rel = Path("night") / block_of(tile) / f"{tile}.oxn"
    src = next(((d, line) for d, line in sources if (d / rel).is_file()), None)
    if src is None:
        plan["notes"].append("no night recipe in any installed package, left dark")
        return plan
    sdir, plan["code"] = src
    plan["source"] = sdir.name
    if sdir not in providers:
        providers[sdir] = sorted({m[3] for n in os.listdir(sdir / "terrain")
                                  if (m := TER_RE.match(n)) and not m[5]})

    sets, uncovered, missing_base = {}, [], []
    for ter in land:
        m = TER_RE.match(ter.name)
        base = BASE_RE.search(ter.read_text(errors="replace"))
        if base is None:
            missing_base.append(ter.name)
            continue
        ours = f"TEXTURE_LIT {base[1]}_LIT.dds"
        theirs = next((sdir / "terrain" / f"{m[1]}_{m[2]}_{p}{m[4]}.ter"
                       for p in providers[sdir]
                       if (sdir / "terrain" / f"{m[1]}_{m[2]}_{p}{m[4]}.ter").is_file()), None)
        if theirs is None:
            uncovered.append((ter.name, ours))
            continue
        lines = lit_lines(theirs.read_text(errors="replace"))
        lines = [ours if l.split()[0] == "TEXTURE_LIT" else l for l in lines]
        sets[tuple(l.split()[0] if l.startswith("TEXTURE_LIT") else l for l in lines)] = lines
        if lines:
            plan["lit"][ter.name] = lines
    if missing_base:
        plan["notes"].append(f"{len(missing_base)} .ter without BASE_TEX left dark")
    if uncovered:
        if len(sets) == 1:
            template = next(iter(sets.values()))
            for name, ours in uncovered:
                if template:
                    plan["lit"][name] = [ours if l.startswith("TEXTURE_LIT") else l
                                         for l in template]
        else:
            plan["notes"].append(
                f"{len(uncovered)} .ter without counterpart left dark: the tile's land .ter "
                f"in {sdir.name} show {len(sets)} distinct LIT sets")
    return plan


def luminances(plan):
    return sorted({l.split()[1] for lines in plan["lit"].values() for l in lines
                   if l.startswith("LUMINANCE ") and len(l.split()) > 1})


def report_night(plans):
    with_recipe = 0
    for tile, plan in plans.items():
        if plan["source"]:
            with_recipe += 1
            print(f"  night {tile}: {plan['source']} ({plan['code']}) "
                  f"{len(plan['lit'])}/{plan['land']} land .ter lit, "
                  f"LUMINANCE {','.join(luminances(plan)) or '-'}")
        for note in plan["notes"]:
            print(f"WARNING: night {tile}: {note}", file=sys.stderr)
    log(f"night: {with_recipe}/{len(plans)} tiles with recipe")


def verify_stage(stage, good, lit):
    """What is wrong with the staged package, measured against the delivered tiles
    and the night plan `lit` {ter name: lines}; an empty list when nothing is."""
    problems, sources = [], {}
    for tile, d, dsf in good:
        if not (stage / "Earth nav data" / block_of(tile) / dsf.name).is_file():
            problems.append(f"{tile}: {dsf.name} missing")
        for png in (d / "textures").glob("*.png"):
            if not (stage / "textures" / png.name).is_file():
                problems.append(f"{tile}: {png.name} missing")
        for ter in (d / "terrain").glob("*.ter"):
            sources.setdefault(ter.name, []).append(ter)
    unlit = lambda text: [l for l in text.splitlines() if not l.split() or l.split()[0] not in LIT_KEYS]
    for name, srcs in sorted(sources.items()):
        staged = stage / "terrain" / name
        if not staged.is_file():
            problems.append(f"{name}: missing")
            continue
        origs = {s.read_text(errors="replace") for s in srcs}
        if len(origs) > 1:
            problems.append(f"{name}: sources disagree across tiles "
                            f"{', '.join(s.parent.parent.name for s in srcs)}")
            continue
        text, orig = staged.read_text(errors="replace"), origs.pop()
        m, want = TER_RE.match(name), lit.get(name)
        if m and m[5] and lit_lines(text):
            problems.append(f"{name}: LIT lines on an overlay .ter")
        elif want is None:
            if text != orig:
                problems.append(f"{name}: differs from its source without a night plan")
        else:
            base = BASE_RE.search(text)
            own = f"TEXTURE_LIT {base[1]}_LIT.dds" if base else None
            got = lit_lines(text)
            if got != want or [l for l in got if l.startswith("TEXTURE_LIT")] != [own] \
                    or unlit(text) != unlit(orig):
                problems.append(f"{name}: LIT lines {got} do not match plan {want}")
    return problems


def sync_file(src, dest_dir):
    shutil.copy2(src, dest_dir / src.name)


def load_spec(path):
    try:
        with open(path, "rb") as f:
            spec = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise Fatal(f"cannot read spec {path}: {e}")
    name = spec.get("metadata", {}).get("name")
    root = spec.get("target", {}).get("root")
    if not isinstance(name, str) or not SAFE_NAME_RE.match(name):
        raise Fatal(f"unsafe or missing metadata.name: {name!r}")
    if not isinstance(root, str) or not root:
        raise Fatal("missing target.root in spec")
    return name, Path(root)


def parse_args(argv):
    p = argparse.ArgumentParser(prog="oxo-package", description=__doc__.split("\n")[0])
    p.add_argument("spec", help="OXO region spec TOML")
    p.add_argument("--code", required=True, help="package region code, e.g. A4_PILOT")
    p.add_argument("--dry-run", action="store_true", help="validate only, change nothing")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--strict", dest="mode", action="store_const", const="strict")
    g.add_argument("--loose", dest="mode", action="store_const", const="loose")
    p.set_defaults(mode="strict")
    p.add_argument("--packages-dir", type=Path,
                   default=Path.home() / ".local/share/xearthlayer/packages")
    p.add_argument("--lock-file", type=Path, default=None, help=argparse.SUPPRESS)
    p.add_argument("--ledger-dir", type=Path, default=Path(__file__).resolve().parents[1] / "ledger",
                   help=argparse.SUPPRESS)
    return p.parse_args(argv)


def run(args):
    if not CODE_RE.fullmatch(args.code):
        raise Fatal(f"invalid --code {args.code!r}: use letters, digits, _ and -, "
                    "starting with a letter or digit")
    name, root = load_spec(args.spec)
    if not root.is_dir():
        raise Fatal(f"target.root not found: {root}")
    pkg_name = f"zzXEL_{name}_ortho"
    pkg = args.packages_dir / pkg_name

    log(f"source:  {root}")
    log(f"package: {pkg}  (code {args.code})")
    log(f"mode:    {args.mode}  dry_run={int(args.dry_run)}")

    pid = check_lock(args.lock_file or default_lock_file())
    if pid is not None:
        msg = f"xearthlayer run is serving (PID {pid}); stop it before packaging"
        if not args.dry_run:
            raise Fatal(msg)
        print(f"WARNING: {msg}", file=sys.stderr)

    tile_dirs = sorted(p for p in root.glob("zOrtho4XP_*") if p.is_dir())
    if not tile_dirs:
        raise Fatal(f"no zOrtho4XP_* tiles under {root}")
    log(f"tiles present: {len(tile_dirs)}")

    good, bad = [], []
    for d in tile_dirs:
        tile = d.name[len("zOrtho4XP_"):]
        dsf, reason = validate_tile(d, tile, args.mode)
        if dsf:
            good.append((tile, d, dsf))
        else:
            bad.append(f"{tile}: {reason}")
    log(f"valid: {len(good)}    rejected: {len(bad)}")
    if bad:
        print("Rejected tiles (sample ≤10):")
        for b in bad[:10]:
            print(f"  - {b}")
        if len(bad) > 10:
            print(f"  ... ({len(bad) - 10} more)")
        raise Fatal(f"{len(bad)} tile(s) rejected, nothing copied")

    sources, providers = night_sources(args.packages_dir, pkg_name), {}
    plans = {tile: night_plan(tile, d, sources, providers) for tile, d, _ in good}
    report_night(plans)

    if args.dry_run:
        log("dry-run: no package changes")
        return

    stage = pkg.with_name(f".{pkg_name}.staging")
    old = pkg.with_name(f".{pkg_name}.old")
    for leftover in (stage, old):
        shutil.rmtree(leftover, ignore_errors=True)
    for sub in ("Earth nav data", "terrain", "textures"):
        (stage / sub).mkdir(parents=True, exist_ok=True)

    total = len(good)
    for n, (tile, d, dsf) in enumerate(good, 1):
        dest_nav = stage / "Earth nav data" / block_of(tile)
        dest_nav.mkdir(exist_ok=True)
        sync_file(dsf, dest_nav)
        for ter in (d / "terrain").glob("*.ter"):
            sync_file(ter, stage / "terrain")
        for png in (d / "textures").glob("*.png"):
            sync_file(png, stage / "textures")
        if n % 50 == 0 or n == total:
            log(f"  staged {n}/{total} (last: {tile})")

    # A .ter shared by neighbouring tiles is staged once per tile; it stays lit if
    # any tile lights it (the lines agree), and its own LIT lines are replaced.
    lit = {}
    for plan in plans.values():
        for ter_name, lines in plan["lit"].items():
            lit.setdefault(ter_name, lines)
    for ter_name, lines in lit.items():
        staged = stage / "terrain" / ter_name
        kept = [l for l in staged.read_text().splitlines()
                if not l.split() or l.split()[0] not in LIT_KEYS]
        staged.write_text("".join(f"{l}\n" for l in kept + lines))

    problems = verify_stage(stage, good, lit)
    if problems:
        print("Staged package problems (sample ≤10):", file=sys.stderr)
        for problem in problems[:10]:
            print(f"  - {problem}", file=sys.stderr)
        shutil.rmtree(stage, ignore_errors=True)
        raise Fatal(f"staged package failed its check ({len(problems)} problem(s)), "
                    "installed package unchanged")
    log("staged package checked: every DSF, .ter and mask present, LIT lines as planned")

    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    (stage / "xearthlayer_scenery_package.txt").write_text(
        f"REGIONAL SCENERY PACKAGE\n1.0.0\n{args.code}  99.99.99\n{now}\nZ\n"
        f"{pkg_name}\n{pkg_name}-99.99.99.tar.gz\n0\n")
    if pkg.exists():
        pkg.rename(old)
    stage.rename(pkg)
    shutil.rmtree(old, ignore_errors=True)
    log("package replaced from staging, metadata written")

    counts = {sub: sum(1 for _ in (pkg / sub).rglob(pat)) for sub, pat in
              (("Earth nav data", "*.dsf"), ("terrain", "*.ter"), ("textures", "*.png"))}
    size = sum(p.stat().st_size for p in pkg.rglob("*") if p.is_file())
    log(f"package {pkg_name}: dsf={counts['Earth nav data']} ter={counts['terrain']} "
        f"png={counts['textures']} size={size / 2**20:.1f}M")

    installs = args.ledger_dir / name / "installs.log"
    installs.parent.mkdir(parents=True, exist_ok=True)
    with installs.open("a") as f:
        f.write(f"{now}\t{args.code}\t{pkg_name}\t{','.join(t for t, _, _ in good)}\n")
    with (installs.parent / "night.tsv").open("a") as f:
        for tile, plan in plans.items():
            f.write("\t".join((now, args.code, tile, plan["source"], plan["code"],
                               str(len(plan["lit"])), ",".join(luminances(plan)),
                               "; ".join(plan["notes"]))) + "\n")
    log(f"ledger: {installs}, night.tsv (commit ops/ledger/)")


def main(argv=None):
    args = parse_args(argv)
    try:
        run(args)
    except Fatal as e:
        print(f"FATAL: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
