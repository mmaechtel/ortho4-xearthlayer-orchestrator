#!/usr/bin/env python3
"""Fetch Geofabrik OSM extracts, keep the books on them, and check tiles against them.

    osm-fetch <region-id>          download <region>-latest.osm.pbf (+ .poly), verify its MD5,
                                   append it to the ledger; e.g. great-britain, us/texas
    osm-fetch --check              newest ledger extract per region vs. Geofabrik's state.txt
    osm-fetch --which TILE...      smallest Geofabrik region wholly containing each 1x1 tile

Files land in /mnt/xplane_data/oxo/osm-pbf (--dir) as <region>-<YYMMDD>.osm.pbf, the date being
the PBF header's osmosis_replication_timestamp. The ledger ops/ledger/osm-extracts.tsv has one
tab-separated line per fetch, no header: region id, file, replication timestamp, md5, fetched at
(UTC). Region metadata and geometry come from Geofabrik's index-v1.json, cached in --dir for a day.

Freshness is read from <region>-updates/state.txt, never from the -latest redirect (germany and
europe redirect to a mirror without a date in the name).

An extract is outdated after 90 days (MAX_AGE_DAYS, not an option); a tile with no recorded
extract timestamp is outdated too. `preflight` is the pre-build check oxo-compose runs before
--submit.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
LEDGER = REPO / "ops/ledger/osm-extracts.tsv"
PBF_DIR = Path("/mnt/xplane_data/oxo/osm-pbf")
OSM_CACHE = Path("/mnt/xplane_data/oxo/osm-cache")
INDEX_URL = "https://download.geofabrik.de/index-v1.json"
MAX_AGE_DAYS = 90
INDEX_MAX_AGE = 24 * 3600
TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"


def _load_bake():
    path = Path(__file__).resolve().with_name("osm-bake")
    loader = importlib.machinery.SourceFileLoader("osm_bake", str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("osm_bake", loader))
    loader.exec_module(mod)
    return mod


osm_bake = _load_bake()  # the tile-inside-polygon logic and the cache layout live there


class FetchError(Exception):
    pass


def parse_tile(name):
    m = re.fullmatch(r"([+-]\d{2})([+-]\d{3})", name)
    if not m:
        raise ValueError(f"not a tile name like +53-003: {name!r}")
    return int(m.group(1)), int(m.group(2))


def file_stem(region_id):
    return region_id.replace("/", "-")


# --- Geofabrik index: regions and their geometry ---

@dataclass
class Region:
    id: str
    pbf: str
    updates: str
    rings: list  # osm_bake ring format: [(is_hole, [(lon, lat), ...]), ...]
    bbox: tuple  # west, south, east, north
    area: float  # square degrees: good enough to order nested regions


def _shoelace(pts):
    return abs(sum(a[0] * b[1] - b[0] * a[1] for a, b in zip(pts, pts[1:] + pts[:1]))) / 2


def regions(index):
    out = []
    for f in index["features"]:
        urls = f["properties"].get("urls", {})
        if "pbf" not in urls:
            continue
        rings, area = [], 0.0
        for polygon in f["geometry"]["coordinates"]:
            for n, ring in enumerate(polygon):
                pts = [(p[0], p[1]) for p in ring[:-1]]  # GeoJSON closes the ring
                rings.append((n > 0, pts))
                area += -_shoelace(pts) if n else _shoelace(pts)
        outer = [p for hole, pts in rings if not hole for p in pts]
        bbox = (min(p[0] for p in outer), min(p[1] for p in outer),
                max(p[0] for p in outer), max(p[1] for p in outer))
        out.append(Region(f["properties"]["id"], urls["pbf"], urls.get("updates", ""), rings, bbox, area))
    return out


def containing(regs, lat, lon):
    """Regions wholly containing the tile, smallest first."""
    for r in sorted(regs, key=lambda r: r.area):
        w, s, e, n = r.bbox
        if w <= lon and lon + 1 <= e and s <= lat and lat + 1 <= n and osm_bake.tile_inside(r.rings, lat, lon):
            yield r


def which(regs, lat, lon):
    return next(containing(regs, lat, lon), None)


# --- the books: ops/ledger/osm-extracts.tsv ---

@dataclass
class Extract:
    region: str
    file: str
    timestamp: datetime
    md5: str
    fetched: str


def parse_ts(text):
    return datetime.strptime(text, TS_FORMAT).replace(tzinfo=timezone.utc)


def is_fresh(timestamp, now):
    return now - timestamp <= timedelta(days=MAX_AGE_DAYS)


def read_ledger(path):
    if not Path(path).exists():
        return []
    rows = [line.split("\t") for line in Path(path).read_text().splitlines() if line.strip()]
    return [Extract(r[0], r[1], parse_ts(r[2]), r[3], r[4]) for r in rows]


def append_ledger(path, region, file, timestamp, md5, fetched):
    with open(path, "a") as f:
        f.write(f"{region}\t{file}\t{timestamp}\t{md5}\t{fetched}\n")


def newest(entries):
    """The extract with the latest replication timestamp, per region."""
    out = {}
    for e in entries:
        if e.region not in out or e.timestamp >= out[e.region].timestamp:
            out[e.region] = e
    return out


def parse_state(text):
    m = re.search(r"^timestamp=(\S+)$", text, re.M)
    if not m:
        raise FetchError("state.txt has no timestamp line")
    return parse_ts(m.group(1).replace("\\", ""))


# --- the pre-build check ---

def read_bake_log(cache):
    """tile -> extract timestamp (None when unknown), the newest line per tile winning."""
    log = Path(cache) / "osm-bake.log"
    out = {}
    if log.exists():
        for line in log.read_text().splitlines():
            cols = line.split("\t")
            if len(cols) >= 2:
                try:
                    out[cols[0]] = parse_ts(cols[1])
                except ValueError:
                    out[cols[0]] = None
    return out


def problems(tiles, cache, now):
    """[(tile, reason)] for every tile that must not be built yet: a layer missing from the
    cache, no recorded extract timestamp, or an extract older than MAX_AGE_DAYS."""
    log, out = read_bake_log(cache), []
    for tile in dict.fromkeys(tiles):
        lat, lon = parse_tile(tile)
        missing = [l for l in osm_bake.LAYERS if not osm_bake.layer_path(cache, lat, lon, l).exists()]
        if missing:
            out.append((tile, "layers missing: " + ", ".join(missing)))
        elif log.get(tile) is None:
            out.append((tile, "no recorded extract timestamp (outdated)"))
        elif not is_fresh(log[tile], now):
            out.append((tile, f"extract {log[tile].strftime(TS_FORMAT)} is {(now - log[tile]).days} days old "
                              f"(limit {MAX_AGE_DAYS})"))
    return out


def _source(tile_regions, newest_extracts, pbf_dir, now):
    """('bake', extract) when a fresh extract on disk covers the tile, else ('fetch', smallest region)."""
    first = None
    for r in tile_regions:
        first = first or r
        e = newest_extracts.get(r.id)
        if e and is_fresh(e.timestamp, now) and (Path(pbf_dir) / e.file).exists():
            return "bake", r, e
    return "fetch", first, None


def preflight(tiles, cache, ledger, pbf_dir, now, load_regions):
    """Report lines for tiles that must not be built yet (empty: all fine), each reason followed
    by the commands that fix it. `load_regions` is only called when something is wrong, and its
    failure (no network) costs the commands, not the reasons."""
    bad = problems(tiles, cache, now)
    if not bad:
        return []
    lines = [f"{tile}: {why}" for tile, why in bad]
    try:
        regs = load_regions()
    except (FetchError, OSError) as e:
        return lines + [f"cannot suggest a fix: {e}"]
    have = newest(read_ledger(ledger))
    fixes, fetches = [], {}
    for tile, _ in bad:
        lat, lon = parse_tile(tile)
        how, region, extract = _source(list(containing(regs, lat, lon)), have, pbf_dir, now)
        if region is None:
            lines.append(f"no Geofabrik region wholly contains {tile}: bake it by hand from a larger extract")
            continue
        if how == "fetch":
            fetches.setdefault(region.id, f"ops/bin/osm-fetch {region.id}")
        pbf = Path(pbf_dir) / extract.file if extract else "<pbf printed by osm-fetch>"
        fixes.append(f"ops/bin/osm-bake --pbf {pbf} --poly {Path(pbf_dir) / (file_stem(region.id) + '.poly')} "
                     f"--out {cache} --tile {lat} {lon} --force")
    if fixes:
        lines += ["fix (a re-bake always takes the whole tile):", *(f"  {c}" for c in fetches.values()),
                  *(f"  {c}" for c in fixes)]
    return lines


# --- network ---

def open_url(url):
    try:
        return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "osm-fetch"}), timeout=60)
    except OSError as e:  # URLError and HTTPError are OSErrors
        raise FetchError(f"{url}: {e}")


def http_get(url):
    with open_url(url) as r:
        return r.read()


def load_index(pbf_dir, now):
    """Geofabrik's index-v1.json from the cache in pbf_dir, refreshed when older than a day."""
    path = Path(pbf_dir) / "index-v1.json"
    if path.exists() and now.timestamp() - path.stat().st_mtime <= INDEX_MAX_AGE:
        return json.loads(path.read_text())
    try:
        data = http_get(INDEX_URL)
    except FetchError as e:
        if not path.exists():
            raise
        print(f"osm-fetch: {e}; using the stale cached index", file=sys.stderr)
        return json.loads(path.read_text())
    Path(pbf_dir).mkdir(parents=True, exist_ok=True)
    part = path.with_name(path.name + ".part")
    part.write_bytes(data)
    os.replace(part, path)
    return json.loads(data)


def download_part(url, part):
    """Stream url into the .part file; returns its md5."""
    md5 = hashlib.md5()
    with open_url(url) as r, open(part, "wb") as f:
        while chunk := r.read(1 << 20):
            md5.update(chunk)
            f.write(chunk)
    return md5.hexdigest()


def header_timestamp(pbf, run):
    r = run(["osmium", "fileinfo", "-F", "pbf", "-g", "header.option.osmosis_replication_timestamp", str(pbf)],
            capture_output=True, text=True)
    try:
        return parse_ts(r.stdout.strip())
    except ValueError:
        raise FetchError(f"{pbf} has no osmosis_replication_timestamp in its header")


def state_timestamp(region):
    return parse_state(http_get(region.updates + "/state.txt").decode())


def fetch_region(region_id, pbf_dir, ledger, now, run):
    pbf_dir = Path(pbf_dir)
    region = next((r for r in regions(load_index(pbf_dir, now)) if r.id == region_id), None)
    if region is None:
        raise FetchError(f"no region {region_id!r} in Geofabrik's index (ids like great-britain, us/texas)")
    stem = file_stem(region_id)
    expected = f"{stem}-{state_timestamp(region):%y%m%d}.osm.pbf"
    if (pbf_dir / expected).exists() and any(e.file == expected for e in read_ledger(ledger)):
        print(f"already have {expected}")
        return
    poly, part = pbf_dir / f"{stem}.poly", pbf_dir / f"{stem}.osm.pbf.part"
    poly_part = poly.with_name(poly.name + ".part")
    poly_part.write_bytes(http_get(region.pbf.removesuffix("-latest.osm.pbf") + ".poly"))
    os.replace(poly_part, poly)
    try:
        md5 = download_part(region.pbf, part)
        want = http_get(region.pbf + ".md5").decode().split()[0]
        if md5 != want:
            raise FetchError(f"{region.pbf}: md5 {md5} does not match Geofabrik's {want}; try again")
        replicated = header_timestamp(part, run)
        name = f"{stem}-{replicated:%y%m%d}.osm.pbf"
        if (pbf_dir / name).exists() and any(e.file == name for e in read_ledger(ledger)):  # a file without a ledger line is replaced
            print(f"already have {name}")
            return
        (pbf_dir / (name + ".md5")).write_text(f"{md5}  {name}\n")
        os.replace(part, pbf_dir / name)
    finally:
        part.unlink(missing_ok=True)
    append_ledger(ledger, region_id, name, replicated.strftime(TS_FORMAT), md5, now.strftime(TS_FORMAT))
    print(pbf_dir / name)


def check(pbf_dir, ledger, now):
    """Newest ledger extract per region against Geofabrik's state.txt; 1 if any region failed."""
    held = newest(read_ledger(ledger))
    if not held:
        print("no extracts recorded")
        return 0
    by_id = {r.id: r for r in regions(load_index(pbf_dir, now))}
    failed = 0
    for rid, e in sorted(held.items()):
        local = e.timestamp.strftime(TS_FORMAT)
        try:
            if rid not in by_id:
                raise FetchError("not in Geofabrik's index any more")
            remote = state_timestamp(by_id[rid])
        except FetchError as err:
            print(f"{rid}  local {local}  error: {err}")
            failed = 1
            continue
        verdict = "newer extract available" if remote > e.timestamp else "current"
        print(f"{rid}  local {local}  geofabrik {remote.strftime(TS_FORMAT)}  {verdict}")
    return failed


def which_cmd(pbf_dir, tiles, now):
    regs = regions(load_index(pbf_dir, now))
    for tile in (t.strip() for t in tiles):
        r = which(regs, *parse_tile(tile))
        print(f"{tile}  {r.id if r else 'none'}")


# --- CLI ---

def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("region", nargs="?", help="Geofabrik region id, e.g. great-britain or us/texas")
    p.add_argument("--check", action="store_true", help="compare the ledger with Geofabrik's state.txt")
    p.add_argument("--which", nargs="+", metavar="TILE", help="region wholly containing each tile, e.g. +53-003")
    p.add_argument("--dir", type=Path, default=PBF_DIR, help=f"PBF directory (default {PBF_DIR})")
    # argparse takes -01+179 for an option; a leading space makes it a plain argument
    argv = [" " + t if re.fullmatch(r"-\d{2}[+-]\d{3}", t) else t for t in (sys.argv[1:] if argv is None else argv)]
    a = p.parse_args(argv)
    if [bool(a.region), a.check, bool(a.which)].count(True) != 1:
        p.error("give exactly one of: a region id, --check, --which TILE...")
    now = datetime.now(timezone.utc)
    try:
        if a.check:
            sys.exit(check(a.dir, LEDGER, now))
        elif a.which:
            which_cmd(a.dir, a.which, now)
        else:
            a.dir.mkdir(parents=True, exist_ok=True)
            fetch_region(a.region, a.dir, LEDGER, now,
                         lambda argv, **kw: subprocess.run(argv, check=True, **kw))
    except (FetchError, ValueError, OSError, subprocess.CalledProcessError) as e:
        sys.exit(f"osm-fetch: {e}")


if __name__ == "__main__":
    main()
