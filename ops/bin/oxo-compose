#!/usr/bin/env python3
"""Compose OXO region specs from three layers and optionally submit them.

    oxo-compose ops/packages/<name>.toml [--out DIR] [--submit URL] [--force] [--osm-check]

Layers, later wins:
  1. baseline  docs/examples/example-region.toml — samsoir's production tuning, read
               straight from the upstream file so his changes arrive with each merge
  2. house     ops/profiles/house.toml — only the keys we deliberately set differently
  3. package   ops/packages/<name>.toml — metadata, target, optional [parameters] for all
               groups, and [[group]]s: tiles plus per-group overrides (any parameter key,
               raw = {...} for Ortho4XP tile keys)

OXO takes one parameter set per spec, so each group becomes its own spec/job. Its
region_code is <code>-<ID> (group `id`, else its 1-based position); a single group keeps
<code>. All groups share metadata.name and target.root, so ops/bin/oxo-package works on
the package file directly. Without --out or --submit the specs are printed.

Keep-or-default (plan D8): for every tile with an adoption record (ops/adopted, oxo-adopt),
each known legacy value that differs from the composed spec must be decided once in the
group's [group.legacy] table as "keep: <reason>" (the group then overrides the key with the
legacy value) or "default: <reason>". --legacy shows the table; --submit refuses while any
difference is undecided. Unknown legacy values follow samsoir, and the ledger says so.

OSM pre-build check (#16): --submit refuses while any tile of the specs lacks one of its five
OSM layers in the cache, or has no recorded extract timestamp in osm-bake.log, or an extract
older than 90 days; it lists each tile with the reason and the osm-fetch / osm-bake commands
that fix it (rules and code: ops/bin/osm-fetch). --force submits anyway; --osm-check runs just
the check (exit 1 on failure).

--group ID composes and submits only that group.

--submit also keeps the books (ops/ledger/<name>/<region_code>-r<rev>.toml: the exact spec,
job id, commits, per-parameter origin of every deviation from samsoir, DEM and patches
per tile) and therefore refuses while ops/ or docs/examples/ has uncommitted changes.
Query with ops/bin/oxo-whence <tile>.
"""
import argparse
import copy
import datetime
import importlib.machinery
import importlib.util
import json
import re
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]


def _load_sibling(name):
    path = Path(__file__).resolve().with_name(name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


osm_fetch = _load_sibling("osm-fetch")  # the pre-build OSM check lives there
BASELINE = REPO / "docs/examples/example-region.toml"
HOUSE = REPO / "ops/profiles/house.toml"
LEDGER = REPO / "ops/ledger"
ADOPTED = REPO / "ops/adopted"
DEM = Path("/mnt/xplane_data/oxo/dem")
OSM_CACHE = osm_fetch.OSM_CACHE
OSM_PBF_DIR = osm_fetch.PBF_DIR
PATCHES = REPO / "ops/patches"
IMAGE = "localhost/oxo-worker:dev"
REGION_CODE = re.compile(r"^[A-Z0-9-]{1,512}$")  # oxo-spec is_well_formed_region_code
BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
PACKAGE_ONLY = ("tiles", "metadata", "target")  # never taken from baseline or house
GROUP_META = ("tiles", "id", "raw", "legacy")  # group keys that are not parameters
CFG_TO_PARAM = {"default_zl": "zoom", "default_website": "provider"}


class ComposeError(Exception):
    pass


def merge(base, over):
    out = copy.deepcopy(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = merge(out[k], v)
        else:
            out[k] = copy.deepcopy(v)
    return out


def _check_region_code(rc):
    if not REGION_CODE.fullmatch(rc):
        raise ComposeError(f"region_code {rc!r} is not valid: only A-Z, 0-9 and '-', 1 to 512 characters")


def compose(baseline, house, package):
    groups = package.get("group") or []
    if not groups:
        raise ComposeError("package has no [[group]]")
    common = {k: v for k, v in merge(baseline, house).items() if k not in PACKAGE_ONLY}
    common = merge(common, {k: v for k, v in package.items() if k != "group"})
    code = common["metadata"]["region_code"]
    _check_region_code(code)
    seen, specs, codes = {}, [], set()
    for i, g in enumerate(groups, 1):
        tiles = g.get("tiles") or []
        if not tiles:
            raise ComposeError(f"group {i} has no tiles")
        for t in tiles:
            if t in seen:
                raise ComposeError(f"tile {t} is in group {seen[t]} and group {i}")
            seen[t] = i
        params = {k: v for k, v in g.items() if k not in GROUP_META}
        if "raw" in g:
            params["raw"] = g["raw"]
        spec = merge(common, {"parameters": params})
        spec["tiles"] = list(tiles)
        if len(groups) > 1:
            spec["metadata"]["region_code"] = f"{code}-{str(g.get('id', i)).upper()}"
        rc = spec["metadata"]["region_code"]
        _check_region_code(rc)
        if rc in codes:
            raise ComposeError(f"duplicate region_code {rc} (group {i}): group ids must be unique "
                               "and must not equal another group's position")
        codes.add(rc)
        specs.append(spec)
    return specs


def _params(layer):
    """Flatten a [parameters] table: curated keys and raw keys side by side."""
    p = dict(layer)
    raw = p.pop("raw", {})
    return {**p, **raw}


def origins(baseline, house, package):
    """Per group: {key: layer} for every parameter whose final value differs from the baseline."""
    base = _params(baseline.get("parameters", {}))
    layers = [("house", _params(house.get("parameters", {}))),
              ("package", _params(package.get("parameters", {})))]
    out = []
    for i, g in enumerate(package.get("group") or [], 1):
        group = {k: v for k, v in g.items() if k not in GROUP_META}
        group.update(g.get("raw", {}))
        named = layers + [(f"group {g.get('id', i)}", group)]
        final, src = dict(base), {}
        for name, values in named:
            for k, v in values.items():
                final[k], src[k] = v, name
        out.append({k: src[k] for k in src if final[k] != base.get(k)})
    return out


def select(specs, groups, gid):
    """(spec, group) pairs, all of them or only group `gid` (by id, else 1-based position)."""
    pairs = list(zip(specs, groups))
    if gid is None:
        return pairs
    picked = [(s, g) for i, (s, g) in enumerate(pairs, 1) if str(g.get("id", i)) == gid]
    if not picked:
        raise ComposeError(f"no group {gid!r} in the package")
    return picked


def known_legacy(adopted, tile):
    """The adoption of the copy XEL serves today (highest priority = lowest code) and its known
    values as spec parameters: observed provider and base ZL, plus an agreeing cfg's keys."""
    hits = []
    for f in sorted(adopted.glob("*.toml")):
        rec = tomllib.loads(f.read_text())
        if tile in rec.get("tiles", {}):
            hits.append((rec["package"]["code"].lower(), rec["package"], rec["tiles"][tile]))
    if not hits:
        return None
    _, pkg, t = min(hits, key=lambda h: h[0])
    values = {}
    for k, v in (t.get("cfg") or {}).items():
        values[CFG_TO_PARAM.get(k, k)] = v
    seen = [re.fullmatch(r"([A-Za-z0-9]+?)(\d{2})", k) for k in t["observed"]["textures"]]
    providers = {m.group(1) for m in seen if m}
    if len(providers) == 1:
        values["provider"] = providers.pop()
    zls = [int(m.group(2)) for m in seen if m]
    if zls:
        values["zoom"] = min(zls)
    if "zoom" in values:
        values["zoom"] = int(values["zoom"])
    return {"package": pkg["name"], "code": pkg["code"], "status": t["cfg_status"], "values": values}


def _same(a, b):
    try:
        return float(a) == float(b)
    except (TypeError, ValueError):
        return str(a) == str(b)


def legacy(spec, group, adopted):
    """Keep-or-default state of one group: undecided differences, decisions, replaced copies."""
    composed = _params(spec["parameters"])
    decisions = dict(group.get("legacy") or {})
    overridden = {k for k in group if k not in GROUP_META} | set(group.get("raw") or {})
    for k, d in decisions.items():
        verdict = str(d).split(":", 1)[0].strip()
        if verdict not in ("keep", "default"):
            raise ComposeError(f"legacy decision for {k} must start with 'keep:' or 'default:', got {d!r}")
        if verdict == "keep" and k not in overridden:
            raise ComposeError(f"legacy decision for {k} is keep, but the group does not override {k}")
    diffs, tiles = {}, {}
    for t in spec["tiles"]:
        known = known_legacy(adopted, t)
        if not known:
            continue
        tiles[t] = f"{known['package']} ({known['code']}) cfg {known['status']}"
        for k, v in known["values"].items():
            if k in composed and not _same(v, composed[k]):
                d = diffs.setdefault(k, {"legacy": {}, "composed": composed[k]})
                d["legacy"].setdefault(str(v), []).append(t)
    return {"undecided": {k: v for k, v in diffs.items() if k not in decisions},
            "decisions": decisions, "tiles": tiles}


def show_legacy(pairs, states):
    for (spec, _), st in zip(pairs, states):
        rc = spec["metadata"]["region_code"]
        print(f"{rc}: replaces " + (", ".join(f"{t} {w}" for t, w in st["tiles"].items()) or "no adopted tile"))
        for k, d in st["undecided"].items():
            old = "; ".join(f"{v} ({', '.join(ts)})" for v, ts in d["legacy"].items())
            print(f"  UNDECIDED {k}: legacy {old}  /  composed {d['composed']}")
        for k, d in st["decisions"].items():
            print(f"  {k}: {d}")


@dataclass
class Env:
    now: str
    ops_commit: str
    ortho4xp_commit: str
    image_id: str
    patches_tree: str
    dem_dir: Path
    patches_dir: Path
    ledger_dir: Path


def _block_and_hgt(tile):
    lat, lon = int(tile[:3]), int(tile[3:])
    block = f"{lat // 10 * 10:+03d}{lon // 10 * 10:+04d}"
    hgt = f"{'N' if lat >= 0 else 'S'}{abs(lat):02d}{'E' if lon >= 0 else 'W'}{abs(lon):03d}.hgt"
    return block, hgt


def _dem(env, tile):
    block, hgt = _block_and_hgt(tile)
    f = env.dem_dir / block / hgt
    if not f.is_file():
        return "missing"
    size = f.stat().st_size
    return "1s" if size > 20e6 else "3s" if size > 2e6 else "other"


def _patches(env, tile):
    block, _ = _block_and_hgt(tile)
    d = env.patches_dir / block / tile
    return sorted(p.name for p in d.iterdir() if p.is_file()) if d.is_dir() else []


def record(spec, overrides, job_id, created, env, legacy_state=None):
    """Write the ledger entry for a newly created job; an existing job is never (re)recorded."""
    m = spec["metadata"]
    path = env.ledger_dir / m["name"] / f"{m['region_code']}-r{m['revision']}.toml"
    if not created:
        # the server ignores metadata.name, so a renamed package still hits the same job;
        # without a record, today's commits would describe a build that never happened
        kept = sorted(env.ledger_dir.glob(f"*/{m['region_code']}-r{m['revision']}.toml"))
        if kept:
            print(f"{m['region_code']}: job already existed, record kept: {kept[0]}")
            return kept[0]
        print(f"{m['region_code']}: job already existed, no ledger record for it; none written")
        return None
    rec = {
        "provenance": {"submitted": env.now, "job_id": job_id, "ops_commit": env.ops_commit,
                       "ortho4xp_commit": env.ortho4xp_commit, "image_id": env.image_id,
                       "patches_tree": env.patches_tree,
                       "overrides": overrides},
        "tiles": {t: {"dem": _dem(env, t), "patches": _patches(env, t)} for t in spec["tiles"]},
        "spec": spec,
    }
    if legacy_state is not None:
        # unknown legacy values follow samsoir; the ledger names what was replaced and decided
        rec["provenance"]["legacy"] = legacy_state["decisions"]
        for t in spec["tiles"]:
            rec["tiles"][t]["replaces"] = legacy_state["tiles"].get(t, "none")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(to_toml(rec))
    return path


def _git(*args):
    return subprocess.run(["git", "-C", str(REPO), *args], check=True, capture_output=True, text=True).stdout.strip()


def gather_env():
    dirty = _git("status", "--porcelain", "--", "ops", "docs/examples", ":!ops/ledger")
    if dirty:
        raise ComposeError("uncommitted changes, commit first so the ledger names a real commit:\n" + dirty)
    try:
        label, image_id = subprocess.run(
            ["podman", "image", "inspect", IMAGE, "--format",
             '{{index .Labels "oxo.ortho4xp-commit"}} {{.Id}}'],
            check=True, capture_output=True, text=True).stdout.split()
    except (OSError, ValueError, subprocess.CalledProcessError):
        raise ComposeError(f"cannot read the Ortho4XP commit and id from image {IMAGE} (make image)")
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return Env(now=now, ops_commit=_git("rev-parse", "HEAD"), ortho4xp_commit=label, image_id=image_id,
               patches_tree=_git("rev-parse", "HEAD:ops/patches"),
               dem_dir=DEM, patches_dir=PATCHES, ledger_dir=LEDGER)


def _key(k):
    return k if BARE_KEY.match(k) else json.dumps(k)


def _value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ", ".join(f"{_key(k)} = {_value(x)}" for k, x in v.items()) + "}"
    raise ComposeError(f"cannot write {type(v).__name__} as TOML")


def to_toml(d, prefix=""):
    lines = [f"{_key(k)} = {_value(v)}" for k, v in d.items() if not isinstance(v, dict)]
    for k, v in d.items():
        if isinstance(v, dict):
            lines += ["", f"[{prefix}{_key(k)}]", to_toml(v, f"{prefix}{_key(k)}.")]
    return "\n".join(lines).strip("\n") + "\n" if not prefix else "\n".join(lines)


def write(specs, out):
    out.mkdir(parents=True, exist_ok=True)
    paths = []
    for s in specs:
        p = out / f"{s['metadata']['region_code']}.toml"
        p.write_text(to_toml(s))
        paths.append(p)
    return paths


def submit(specs, overrides, url, env, states=None):
    for s, o, st in zip(specs, overrides, states or [None] * len(specs)):
        req = urllib.request.Request(url.rstrip("/") + "/api/v1/jobs", data=to_toml(s).encode(), method="POST")
        try:
            with urllib.request.urlopen(req) as r:
                body = json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            raise ComposeError(f"{s['metadata']['region_code']}: HTTP {e.code} {e.read().decode()}")
        path = record(s, o, body["job_id"], body["created"], env, st)
        print(f"{s['metadata']['region_code']}: job {body['job_id']} "
              f"({'created' if body['created'] else 'existing'}, {body['total_tasks']} tasks) -> {path}")
    print("commit ops/ledger/ now: git add ops/ledger && git commit")


def osm_report(specs, now=None):
    """Lines naming every tile of the specs whose OSM data is missing or outdated, with the
    commands that fix it; empty when all is ready (ops/bin/osm-fetch has the rules)."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    tiles = [t for s in specs for t in s["tiles"]]
    return osm_fetch.preflight(tiles, OSM_CACHE, osm_fetch.LEDGER, OSM_PBF_DIR, now,
                               lambda: osm_fetch.regions(osm_fetch.load_index(OSM_PBF_DIR, now)))


def osm_gate(specs):
    lines = osm_report(specs)
    if lines:
        raise ComposeError("OSM data not ready (--force submits anyway):\n  " + "\n  ".join(lines))


def load(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("package", type=Path)
    p.add_argument("--out", type=Path, help="write one <region_code>.toml per group here")
    p.add_argument("--submit", metavar="URL", help="POST each spec to oxo-controld, e.g. http://127.0.0.1:8080")
    p.add_argument("--group", metavar="ID", help="only this group (its id, else its 1-based position)")
    p.add_argument("--legacy", action="store_true", help="show the keep-or-default state per group")
    p.add_argument("--osm-check", action="store_true", help="check the OSM cache for every tile, submit nothing")
    p.add_argument("--force", action="store_true", help="submit although the OSM check fails")
    a = p.parse_args()
    try:
        layers = load(BASELINE), load(HOUSE), load(a.package)
        groups = layers[2].get("group") or []
        all_specs = compose(*layers)
        pairs = select(all_specs, groups, a.group)
        specs = [s for s, _ in pairs]
        overrides = [o for (s, o) in zip(all_specs, origins(*layers)) if any(s is x for x in specs)]
        states = [legacy(s, g, ADOPTED) for s, g in pairs]
        if a.legacy:
            show_legacy(pairs, states)
        if a.out:
            for path in write(specs, a.out):
                print(path)
        if a.submit:
            open_ = [f"{s['metadata']['region_code']}: {k}" for s, st in zip(specs, states) for k in st["undecided"]]
            if open_:
                raise ComposeError("undecided legacy values (see --legacy), decide them in [group.legacy]:\n  "
                                   + "\n  ".join(open_))
            if not a.force:
                osm_gate(specs)
            submit(specs, overrides, a.submit, gather_env(), states)
        if a.osm_check:
            osm_gate(specs)
            print(f"OSM data ready for {sum(len(s['tiles']) for s in specs)} tiles")
        if not (a.out or a.submit or a.legacy or a.osm_check):
            print("\n# ---\n".join(to_toml(s) for s in specs), end="")
    except (OSError, tomllib.TOMLDecodeError, ComposeError, KeyError, subprocess.CalledProcessError) as e:
        sys.exit(f"oxo-compose: {e}")


if __name__ == "__main__":
    main()
